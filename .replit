modules = ["python-3.12"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CONFIG_PATH = "/home/runner/workspace/config"
DOWNLOAD_PATH = "/home/runner/workspace/download"
DOWNLOAD_PATH_TORRENTS = "/home/runner/workspace/watch"
TZ = "Asia/Amman"
START_FROM_LATEST = "true"
MAX_CONCURRENT_TASKS = "2"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd telegram-downloader && python app.py"

[workflows.workflow.metadata]
outputType = "console"
